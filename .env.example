# local (default): in-browser store seeded from src/seed/seed.json, persisted under localStorage "kafaa.local.v1"
# supabase: kafaa_* tables and RPCs in NEXUS project hlirqxoddysxtdezwcgv, using NEXUS's same-origin session.
#           Migrations are applied (2026-10-08) and verified end to end; the live seed is still partial, so keep
#           local as the default until the CONTRACT.md changelog records a complete live seed.
VITE_KAFAA_BACKEND=local
VITE_SUPABASE_URL=https://hlirqxoddysxtdezwcgv.supabase.co
# Public anon key (already shipped in the NEXUS bundle by design). Leave empty to use the built-in default.
VITE_SUPABASE_ANON_KEY=
VITE_NEXUS_DEMO_PASSWORD=
