# supabase (default): kafaa_* tables and RPCs in NEXUS project hlirqxoddysxtdezwcgv. Role cards sign in to Supabase Auth
#           with the NEXUS demo accounts (<persona>@demo.enec-nexus.ae) and store the session in NEXUS's format
#           (nexus.auth.v1.sessions / nexus.active / nexus.auth.v1.consent), so on the NEXUS origin it is shared with NEXUS.
# local   : fallback. In-browser store seeded from src/seed/seed.json, persisted under localStorage "kafaa.local.v1";
#           all 57 personas (including the Kafa'a-only ones) sign in without passwords.
VITE_KAFAA_BACKEND=supabase
VITE_SUPABASE_URL=https://hlirqxoddysxtdezwcgv.supabase.co
# Public anon key (already shipped in the NEXUS bundle by design). Leave empty to use the built-in default.
VITE_SUPABASE_ANON_KEY=
# Where "Back to NEXUS" and NEXUS deep links go when Kafa'a is not served on the NEXUS origin.
VITE_NEXUS_URL=https://enecai.xyz/
# The shared NEXUS demo password. Put it in .env.local only (gitignored); never commit it.
VITE_NEXUS_DEMO_PASSWORD=
